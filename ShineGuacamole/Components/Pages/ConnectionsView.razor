@using ShineGuacamole.Components.Pages
@using ShineGuacamole.Components
@using ShineGuacamole.Shared

@attribute [Route(AppRoutes.Connections)]

@inherits ShineComponentBase<ConnectionsView>

<PageView PageTitle="Connections View">
    @if (_isLoading)
    {
        <LoadingComponent />
    }
    else if (_connections == null || !_connections.Any())
    {
        <NoItemsView />
    }
    else
    {
        <div class="connections">
            <MudGrid>
                @foreach (var connection in _connections)
                {
                    <MudItem xs="3">
                        <RemoteConnection Connection="connection" />
                    </MudItem>
                }
            </MudGrid>
        </div>
    }
</PageView>
